aws_region            = "us-east-1"
project_name          = "cloudops-terraform-lab"
environment           = "dev"
vpc_cidr              = "10.20.0.0/16"
public_subnet_cidr    = "10.20.1.0/24"
private_subnet_a_cidr = "10.20.11.0/24"
private_subnet_b_cidr = "10.20.12.0/24"

# Replace with your current public IP using /32.
# Example only:
allowed_ssh_cidr = "203.0.113.10/32"

# Existing AWS key pair name. Do not put PEM file contents here.
ec2_key_name      = "cloudops-terraform-key"
ec2_instance_type = "t3.micro"

# RDS values. Do not commit real passwords.
db_name              = "studentrecords"
db_username          = "cloudadmin"
db_password          = "REPLACE_WITH_STRONG_PASSWORD_DO_NOT_COMMIT"
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
